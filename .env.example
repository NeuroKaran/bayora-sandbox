# ==============================================================================
# Bayora Sandbox Environment Configuration Template (.env.example)
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# Target client model served by Ollama
MODEL_NAME=qwen2.5-coder:3b

# Ollama API Endpoint
# - Inside Docker Compose: http://client-llm:11434/api/generate
# - Local host dev:        http://localhost:11434/api/generate
OLLAMA_URL=http://client-llm:11434/api/generate

# Gateway Configuration
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0

# Audit Log Configuration
BAYORA_AUDIT_LOG=audit/log.jsonl

# Allowed tenant identifiers
ALLOWED_TENANTS=red-team,blue-team

# Tenant Authentication Secrets (Phase 5 Access Control)
REDTEAM_API_KEY=bayora-redteam-live-secret-key-change-me
BLUETEAM_API_KEY=bayora-blueteam-live-secret-key-change-me
